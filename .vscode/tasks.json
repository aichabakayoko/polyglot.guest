{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build Polyglot Quest",
            "command": "gcc",
            "args": [
                "src/main.c",
                "src/data.c",
                "src/logic.c",
                "-o",
                "game.exe",
                "-Isrc",
                "-L.",
                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}